<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Advisor_Required_Once_Enrolled</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Enrolment_Status__c, &apos;Enrolled&apos;) &amp;&amp; ISBLANK(Faculty_Advisor__c)</errorConditionFormula>
    <errorDisplayField>Faculty_Advisor__c</errorDisplayField>
    <errorMessage>An enrolled student must have an assigned Faculty Advisor.</errorMessage>
</ValidationRule>
