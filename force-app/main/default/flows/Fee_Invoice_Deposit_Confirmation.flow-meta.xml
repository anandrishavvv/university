    <decisions>
        <name>Check_Deposit_Paid</name>
        <label>Check Deposit Paid</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Not Deposit Paid</defaultConnectorLabel>
        <rules>
            <name>Deposit_Is_Paid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payment_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Paid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Enrolment_Deposit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Student__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Student_To_Enrolled</targetReference>
            </connector>
            <label>Deposit Is Paid</label>
        </rules>
    </decisions>
    <interviewLabel>Fee Invoice Deposit Confirmation {!$Flow.CurrentDateTime}</interviewLabel>
