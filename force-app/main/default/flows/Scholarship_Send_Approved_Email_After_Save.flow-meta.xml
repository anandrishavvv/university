        <label>Get Student</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Owner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Student__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Student__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_If_Approved</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Approval_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>Scholarship__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>text_EmailBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Dear Student,

We are pleased to inform you that your scholarship award &apos;{!$Record.Scholarship_Name__c}&apos; has been approved!

Discount Percentage: {!$Record.Discount_Percent__c}%
Applicable Terms: {!$Record.Valid_From_Term__c} to {!$Record.Valid_To_Term__c}

This discount will be automatically credited to your upcoming fee invoices.

Financial Aid Committee
Brightford University</text>
    </textTemplates>
