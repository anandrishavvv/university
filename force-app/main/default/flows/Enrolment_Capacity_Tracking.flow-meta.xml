<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Registration_Path</name>
        <label>Check Registration Path</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No Capacity Change</defaultConnectorLabel>
        <rules>
            <name>Is_New_Registration</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fx_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Enrolment_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Registered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Course_Offering_For_Increment</targetReference>
            </connector>
            <label>Is New Registration</label>
        </rules>
        <rules>
            <name>Is_Course_Dropped</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Enrolment_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Dropped</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Enrolment_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Dropped</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Course_Offering_For_Decrement</targetReference>
            </connector>
            <label>Is Course Dropped</label>
        </rules>
    </decisions>
    <formulas>
        <name>fx_DecrementCount</name>
        <dataType>Number</dataType>
        <expression>MAX(0, BLANKVALUE({!Get_Course_Offering_For_Decrement.Current_Enrolment_Count__c}, 0) - 1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fx_IncrementCount</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Get_Course_Offering_For_Increment.Current_Enrolment_Count__c}, 0) + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fx_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Enrolment Capacity Tracking {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Enrolment Capacity Tracking</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Course_Offering_For_Decrement</name>
        <label>Get Course Offering For Decrement</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decrement_Seat_Count</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Course_Offering__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Course_Offering__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Course_Offering_For_Increment</name>
        <label>Get Course Offering For Increment</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Increment_Seat_Count</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Course_Offering__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Course_Offering__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Decrement_Seat_Count</name>
        <label>Decrement Seat Count</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Course_Offering_For_Decrement.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Current_Enrolment_Count__c</field>
            <value>
                <elementReference>fx_DecrementCount</elementReference>
            </value>
        </inputAssignments>
        <object>Course_Offering__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Increment_Seat_Count</name>
        <label>Increment Seat Count</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Course_Offering_For_Increment.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Current_Enrolment_Count__c</field>
            <value>
                <elementReference>fx_IncrementCount</elementReference>
            </value>
        </inputAssignments>
        <object>Course_Offering__c</object>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Registration_Path</targetReference>
        </connector>
        <object>Enrolment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
